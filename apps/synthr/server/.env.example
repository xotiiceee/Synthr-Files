# Synthr Cyber x402 Server Configuration
# Copy to .env and fill in.
# Start on Base Sepolia, then switch to Base mainnet after public testing.

# Your receiving wallet address (payTo). This is where USDC micropayments settle.
PAY_TO_ADDRESS=0x1111111111111111111111111111111111111111

# Facilitator - use CDP for production/mainnet (get keys at cdp.coinbase.com)
# For local testnet: https://x402.org/facilitator
FACILITATOR_URL=https://x402.org/facilitator

# Network for pricing (CAIP-2 format). Base Sepolia for test: eip155:84532
# Production example: eip155:8453 for Base mainnet
NETWORK=eip155:84532

# Default price per call in USD (USDC). Start low for adoption e.g. 0.005 or 0.01
DEFAULT_PRICE_USD=0.005

# Host bind for Docker publishing. Use 127.0.0.1 on VPS when sitting behind Caddy.
BIND_HOST=127.0.0.1

# CORS: use * for local testing only. Set this to your real app origin on VPS.
# Examples:
# CORS_ORIGIN=https://yourdomain.com
# CORS_ORIGIN=https://app.yourdomain.com
CORS_ORIGIN=*

# Public HTTPS origin used in discovery metadata and x402 payment challenges.
PUBLIC_BASE_URL=https://synthr.online

# LLM provider for synthesis (optional for MVP, use stub). Example OpenAI or local.
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini or local model

# Port
PORT=3000

# Log level: debug | info | warn | error
LOG_LEVEL=info

# Basic rate limiting for public deployment.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60

# For future: Database, vector store, etc.
# DATABASE_URL=postgres://...
