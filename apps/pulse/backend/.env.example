# Pulse Backend (Rust) Environment
# Copy to .env and fill values for full 10/10 experience.

# === Qdrant (Semantic Cache) - REQUIRED for production cache wins ===
QDRANT_URL=http://localhost:6334
# QDRANT_API_KEY=your-key-if-cloud

# === Embeddings for semantic layer ===
# Cheap + high quality for cache. Use a small cheap model.
OPENAI_API_KEY=sk-...

# Alternative (future, for zero-marginal-cost offline): enable fastembed in code
# FASTEMBED_MODEL=BAAI/bge-small-en-v1.5

# === ClawAPIs x402 (the cheap high-signal X data source) ===
# Point at the real ClawAPIs / ClawNet x402 endpoint when available.
# The router will call this for fresh data on miss (~$0.001 per call).
CLAW_APIS_BASE=https://api.clawapis.com   # or your actual endpoint / facilitator
CLAW_WALLET_REF=service-primary            # reference to your funded wallet / facilitator credential

# For real x402 micropayments (when we integrate x402-rs):
# X402_FACILITATOR=coinbase
# WALLET_PRIVATE_KEY=...   # NEVER commit. Use secrets manager in prod.

# === Gateway behavior ===
PULSE_X_INTEL_SEMANTIC_THRESHOLD=0.88   # 0.82-0.95. Lower for chatty mentions, higher for facts.
DEFAULT_SINCE_HOURS=24

# Logging
RUST_LOG=pulse_backend=info,tower_http=info

# === Clerk auth ===
# Production auth should use real Clerk verification.
# Set PULSE_ALLOW_DEMO_AUTH=true only for local/dev testing.
PULSE_ALLOW_DEMO_AUTH=false
CLERK_JWT_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
# Preferred if you want the backend to verify against Clerk's live JWKS directly:
# CLERK_JWKS_URL=https://your-instance.clerk.accounts.dev/.well-known/jwks.json
# Optional: comma-separated allowed frontend origins / parties from Clerk.
# CLERK_AUTHORIZED_PARTIES=https://pulse.synthr.online

# === Phase 2 goal execution runtime ===
# When set, /v1/goal/start dispatches persisted goals to this worker endpoint:
#   POST $PULSE_GOAL_WORKER_URL/workflows/goal-decompose-and-execute
# The worker should start the Temporal GoalDecomposeAndExecute workflow using
# the supplied workflowId and existing goal execution id.
# Omit locally to keep using the checkpointed demo runner.
# PULSE_GOAL_WORKER_URL=http://localhost:8787
# PULSE_GOAL_WORKER_TOKEN=replace-with-shared-secret
PULSE_GOAL_WORKER_FALLBACK_DEMO=true

# === Future: when this becomes the main hosted surface ===
# DATABASE_URL=postgres://...
# STRIPE_...
