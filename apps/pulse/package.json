{
  "name": "pulse",
  "version": "1.0.0",
  "description": "Pulse — see PULSE_ACTUALIZATION_PLAN.md for the current development status and how to run the split app (frontend/ + backend/). This package.json is legacy from the monolith reorg.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:backend": "cd backend && cargo run",
    "dev:frontend": "cd frontend && pnpm dev",
    "dev": "echo 'Use docker compose up -d in backend/, then run dev:backend and dev:frontend in separate terminals. See PULSE_ACTUALIZATION_PLAN.md Phase 0'",
    "build:ui": "cd frontend && pnpm build",
    "build:backend": "cd backend && cargo build --release",
    "build": "pnpm build:ui && pnpm build:backend",
    "lint": "cd frontend && pnpm lint",
    "typecheck": "cd frontend && pnpm exec tsc -b",
    "test": "cd frontend && pnpm exec tsc -b && echo 'no frontend tests yet (legacy tests archived)'",
    "plan": "cat PULSE_ACTUALIZATION_PLAN.md | head -100"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.14",
    "@octokit/rest": "^20.1.2",
    "better-sqlite3": "^12.8.0",
    "dotenv": "^16.4.0",
    "hono": "^4.12.23",
    "soma-heart": "^0.8.0",
    "tsx": "^4.22.3",
    "viem": "^2.21.0",
    "x402-fetch": "^0.1.0",
    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.0.0",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
