{
  "name": "synthr-monorepo",
  "version": "1.0.0",
  "description": "Synthr — AI Design Tools Directory + Pulse — X marketing automation",
  "private": true,
  "scripts": {
    "pulse:dev": "pnpm --filter frontend dev",
    "pulse:build": "pnpm --filter frontend build",
    "pulse:lint": "pnpm --filter frontend lint",
    "pulse:backend:dev": "cd apps/pulse/backend && cargo run",
    "pulse:backend:build": "cd apps/pulse/backend && cargo build --release",
    "synthr:dev": "npm --prefix apps/synthr/server run dev",
    "synthr:build": "npm --prefix apps/synthr/server run build",
    "synthr:start": "npm --prefix apps/synthr/server run start",
    "synthr:typecheck": "npm --prefix apps/synthr/server run typecheck",
    "generate": "pnpm --filter @synthr/marketing generate"
  }
}
